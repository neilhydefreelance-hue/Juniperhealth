---
/** Lets a visitor switch off our cookie-free visitor statistics on this browser. */
---
<div class="box" data-optout style="margin-block:var(--space-l)">
  <h3 style="font-size:1.1rem">Visitor statistics on this browser</h3>
  <p data-optout-status class="small" role="status">Checking your setting...</p>
  <div class="cluster" style="margin-top:var(--space-s)">
    <button type="button" class="btn" data-optout-off>Turn statistics off</button>
    <button type="button" class="btn btn--ghost" data-optout-on>Turn statistics back on</button>
  </div>
</div>
<script>
  const box = document.querySelector<HTMLElement>('[data-optout]');
  if (box) {
    const status = box.querySelector<HTMLElement>('[data-optout-status]')!;
    const key = 'jh-analytics-optout';
    const read = () => {
      try {
        return localStorage.getItem(key) === '1';
      } catch {
        return null;
      }
    };
    const render = () => {
      const v = read();
      const signal = (navigator as Navigator & { globalPrivacyControl?: boolean }).globalPrivacyControl || navigator.doNotTrack === '1';
      status.textContent =
        v === null
          ? 'Your browser is blocking storage, so we cannot remember a choice on this browser. You can also block statistics with a privacy setting or add-on in your browser.'
          : v || signal
            ? 'Statistics are OFF on this browser.'
            : 'Statistics are ON on this browser. They do not use cookies and cannot identify you.';
    };
    box.querySelector('[data-optout-off]')?.addEventListener('click', () => {
      try { localStorage.setItem(key, '1'); } catch {}
      render();
    });
    box.querySelector('[data-optout-on]')?.addEventListener('click', () => {
      try { localStorage.removeItem(key); } catch {}
      render();
    });
    render();
  }
</script>
