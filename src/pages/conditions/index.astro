---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { aToZ, categories, hubs } from '../../lib/topics';
import { abs, SITE_ID } from '../../lib/schema';

const cats = await categories();
const groups = await Promise.all(cats.map(async (c) => ({ category: c, conditions: await hubs('conditions', c.id) })));
const name = (c: (typeof groups)[number]['conditions'][number]) => c.data.conditionName || c.data.title;
// One list of every condition in every group, A to Z.
const all = groups.flatMap((g) => g.conditions).sort((a, b) => aToZ(name(a), name(b)));

const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${abs('/conditions/')}#webpage`,
    url: abs('/conditions/'),
    name: 'Health conditions',
    isPartOf: { '@id': SITE_ID },
    breadcrumb: { '@id': `${abs('/conditions/')}#breadcrumb` },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: cats.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.data.title, url: abs(`/conditions/${c.id}/`) })),
    },
  },
];
---
<BaseLayout
  title="Health conditions explained"
  description="Plain-English guides to long-term health conditions: symptoms, diagnosis, treatment, living well, work and the benefits you may be able to claim."
  crumbs={[{ name: 'Home', href: '/' }, { name: 'Health conditions', href: '/conditions/' }]}
  schema={schema}
>
  <div class="wrap" style="padding-bottom:var(--space-3xl)">
    <header class="page-head">
      <h1>Health conditions explained</h1>
      <p class="lead">Clear, practical guides to living with a long-term health condition, from getting a diagnosis to getting the support you are entitled to.</p>
    </header>

    <div class="grid">
      {groups.map(({ category, conditions }) => (
        <article class="card">
          <span class="card__icon"><Icon name={category.data.cardIcon} /></span>
          <h2><a class="card__link" href={`/conditions/${category.id}/`}>{category.data.title}</a></h2>
          <p>{category.data.summary}</p>
          <p class="small muted">{conditions.length} {conditions.length === 1 ? 'condition' : 'conditions'}</p>
          <span class="card__more" aria-hidden="true">See all &rarr;</span>
        </article>
      ))}
      <article class="card" style="box-shadow:none;border-style:dashed;background:transparent">
        <h2>More coming soon</h2>
        <p>We are adding new conditions and groups regularly. <a href="/contact/">Tell us what you would like us to cover next</a>.</p>
      </article>
    </div>

    <section class="prose" aria-labelledby="a-z" style="margin-top:var(--space-2xl)">
      <h2 id="a-z">All conditions, A to Z</h2>
      <ul class="az-list">
        {all.map((c) => (
          <li><a href={`/conditions/${c.id}/`}>{name(c)}</a></li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
