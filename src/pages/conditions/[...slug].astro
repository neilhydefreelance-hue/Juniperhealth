---
import { render, type CollectionEntry } from 'astro:content';
import TopicLayout from '../../layouts/TopicLayout.astro';
import CategoryLayout from '../../layouts/CategoryLayout.astro';
import { categories, hubs, topicPaths } from '../../lib/topics';

type Entry = CollectionEntry<'conditions'>;

export async function getStaticPaths() {
  const cats = await categories();
  const categoryPaths = await Promise.all(
    cats.map(async (category) => ({
      params: { slug: category.id },
      props: { entry: category, conditions: await hubs('conditions', category.id) },
    })),
  );
  return [...categoryPaths, ...(await topicPaths('conditions'))];
}

const props = Astro.props as {
  entry: Entry;
  hub?: Entry;
  pages?: Entry[];
  category?: Entry;
  conditions?: Entry[];
};
const { Content, headings } = await render(props.entry);
---
{props.conditions ? (
  <CategoryLayout entry={props.entry} conditions={props.conditions}>
    <Content />
  </CategoryLayout>
) : (
  <TopicLayout kind="conditions" entry={props.entry} hub={props.hub!} pages={props.pages!} category={props.category} headings={headings}>
    <Content />
  </TopicLayout>
)}
