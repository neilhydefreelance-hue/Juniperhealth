---
import { render, type CollectionEntry } from 'astro:content';
import TopicLayout from '../../layouts/TopicLayout.astro';
import { topicPaths } from '../../lib/topics';

export const getStaticPaths = () => topicPaths('benefits');
type Entry = CollectionEntry<'benefits'>;
const { entry, hub, pages } = Astro.props as { entry: Entry; hub: Entry; pages: Entry[] };
const { Content, headings } = await render(entry);
---
<TopicLayout kind="benefits" entry={entry} hub={hub} pages={pages} headings={headings}>
  <Content />
</TopicLayout>
