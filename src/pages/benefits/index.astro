---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { hubs } from '../../lib/topics';
import { abs, SITE_ID } from '../../lib/schema';
import { TOOLS } from '../../data/site';

const benefits = await hubs('benefits');
const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${abs('/benefits/')}#webpage`,
    url: abs('/benefits/'),
    name: 'Disability benefits',
    isPartOf: { '@id': SITE_ID },
    breadcrumb: { '@id': `${abs('/benefits/')}#breadcrumb` },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: benefits.map((b, i) => ({ '@type': 'ListItem', position: i + 1, name: b.data.title, url: abs(`/benefits/${b.id}/`) })),
    },
  },
];
---
<BaseLayout
  title="Disability and health benefits explained"
  description="Plain English guides to PIP, Attendance Allowance, DLA, ESA and the Universal Credit health element in England and Wales, with free self-checks."
  crumbs={[{ name: 'Home', href: '/' }, { name: 'Benefits', href: '/benefits/' }]}
  schema={schema}
>
  <div class="wrap" style="padding-bottom:var(--space-3xl)">
    <header class="page-head">
      <h1>Disability benefits</h1>
      <p class="lead">Extra money if you have a long-term health condition or disability. Some benefits help with the extra costs of disability. Others help if your health stops you working.</p>
    </header>

    <section class="prose" aria-labelledby="which" style="margin-bottom:var(--space-2xl)">
      <h2 id="which">Which benefit is right for me?</h2>
      <p>It mostly depends on age:</p>
      <table>
        <thead><tr><th scope="col">Age</th><th scope="col">Benefit</th><th scope="col">Self-check</th></tr></thead>
        <tbody>
          <tr><td>Under 16</td><td><a href="/benefits/dla/">DLA for children</a></td><td><a href={TOOLS.dla.href}>DLA check</a></td></tr>
          <tr><td>16 to State Pension age</td><td><a href="/benefits/pip/">Personal Independence Payment (PIP)</a></td><td><a href={TOOLS.pip.href}>PIP points self-check</a></td></tr>
          <tr><td>State Pension age or over</td><td><a href="/benefits/attendance-allowance/">Attendance Allowance</a></td><td><a href={TOOLS.aa.href}>Attendance Allowance check</a></td></tr>
        </tbody>
      </table>
      <p class="small muted">If you already get PIP or DLA when you reach State Pension age, you can usually keep it. In Scotland, these benefits are being replaced by payments from Social Security Scotland.</p>
      <p>PIP, Attendance Allowance and DLA do not depend on your income or savings, and you can get them whether or not you work.</p>

      <h2 id="work">If your health stops you working</h2>
      <p>These benefits are about work, not the extra costs of disability. You can get them as well as PIP.</p>
      <table>
        <thead><tr><th scope="col">Benefit</th><th scope="col">Who it is for</th></tr></thead>
        <tbody>
          <tr><td><a href="/benefits/esa/">New Style ESA</a></td><td>People who cannot work, or can only work a little, and have paid enough National Insurance. Savings do not matter.</td></tr>
          <tr><td><a href="/benefits/universal-credit-health/">Universal Credit health element</a></td><td>People on Universal Credit whose health means they cannot work or prepare for work. Universal Credit depends on income and savings.</td></tr>
        </tbody>
      </table>
    </section>

    <div class="grid">
      {benefits.map((b) => (
        <article class="card">
          <h2><a class="card__link" href={`/benefits/${b.id}/`}>{b.data.title}</a></h2>
          <p>{b.data.summary}</p>
          <span class="card__more" aria-hidden="true">Read the guide &rarr;</span>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
